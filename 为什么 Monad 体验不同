 2.4 技术栈

| 层级 | 选型 | 理由 |
|------|------|------|
| 合约 | Solidity + Foundry | Monad 完全 EVM 兼容，工具链零迁移成本 |
| 链交互 | viem + Monad Testnet RPC | 轻量、类型安全、支持 event 订阅 |
| 前端 | Next.js + TailwindCSS | SSR + 快速渲染，适合实时数据展示 |
| Agent AI | 链下 LLM 推理（OpenAI / 本地模型） | AI 决策在链下完成，仅将动作结果提交链上 |
| 状态同步 | 链上 event 直连前端 | Monad 延迟低（~400ms），无需额外索引层（如 The Graph） |

2.5 关键合约伪代码

```solidity
// BattleEngine.sol — 核心战斗逻辑
contract BattleEngine {
    struct BattleState {
        uint256 battleId;
        uint256 agentAId;
        uint256 agentBId;
        uint256 hpA;
        uint256 hpB;
        uint256 turn;       // 当前回合
        address winner;
        bool active;
    }

    mapping(uint256 => BattleState) public battles;
    uint256 public nextBattleId;

    event MoveExecuted(
        uint256 indexed battleId,
        uint256 agentId,
        uint8 actionType,   // 0=attack, 1=defend, 2=skill
        uint256 targetAgent,
        uint256 damage,
        uint256 turn
    );

    event BattleEnded(uint256 indexed battleId, uint256 winnerId);

    // Agent 提交动作 — 这是高频调用的核心函数
    function submitMove(
        uint256 battleId,
        uint8 actionType,
        uint256 targetAgent
    ) external {
        BattleState storage battle = battles[battleId];
        require(battle.active, "Battle not active");
        require(msg.sender == agentOwner, "Not agent owner");

        // 执行动作逻辑
        uint256 damage = _resolveAction(battle, actionType, targetAgent);

        emit MoveExecuted(battleId, agentId, actionType, targetAgent, damage, battle.turn);

        // 检查胜负
        if (battle.hpA == 0 || battle.hpB == 0) {
            battle.active = false;
            battle.winner = battle.hpA == 0 ? battle.agentBId : battle.agentAId;
            emit BattleEnded(battleId, battle.winner);
            leaderboard.updateRating(battle.winner, battle.loser);
        }

        battle.turn++;
    }
}
```

